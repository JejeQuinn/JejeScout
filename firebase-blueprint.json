{
  "entities": {
    "Siswa": {
      "title": "Siswa",
      "description": "Data anggota Pramuka Penegak SMK Bakti Idhata",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "nama_lengkap": { "type": "string", "maxLength": 200 },
        "kelas": { "type": "string", "maxLength": 100 },
        "nis": { "type": "string", "maxLength": 50 },
        "tahun_ajaran": { "type": "string", "maxLength": 50 },
        "status_aktif": { "type": "boolean" },
        "status_pelantikan": { "type": "string", "maxLength": 100 },
        "tanggal_pelantikan": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "nama_lengkap", "kelas", "nis", "status_aktif"]
    },
    "Kehadiran": {
      "title": "Kehadiran",
      "description": "Catatan absensi latihan kepramukaan",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "siswa_id": { "type": "string", "maxLength": 128 },
        "tanggal": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["Hadir", "Izin", "Sakit", "Alpa"] },
        "keterangan": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "siswa_id", "tanggal", "status"]
    },
    "Materi": {
      "title": "Materi",
      "description": "Silabus dan modul latihan mingguan",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "judul_materi": { "type": "string", "maxLength": 200 },
        "kategori": { "type": "string", "enum": ["Umum", "Tekpram", "Karakter"] },
        "tanggal_pelaksanaan": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["Selesai", "Direncanakan"] }
      },
      "required": ["id", "judul_materi", "kategori", "tanggal_pelaksanaan", "status"]
    },
    "SKU": {
      "title": "SKU",
      "description": "Catatan kelulusan butir SKU siswa",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "siswa_id": { "type": "string", "maxLength": 128 },
        "no_item_sku": { "type": "number" },
        "tanggal_lulus": { "type": "string", "maxLength": 50 },
        "status_verifikasi": { "type": "boolean" },
        "tingkat": { "type": "string", "enum": ["Bantara", "Laksana"] },
        "pembina_verifikator": { "type": "string", "maxLength": 200 }
      },
      "required": ["id", "siswa_id", "no_item_sku", "tanggal_lulus", "status_verifikasi"]
    },
    "SKUItemDef": {
      "title": "SKUItemDef",
      "description": "Definisi master butir SKU Bantara dan Laksana",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "no_item": { "type": "number" },
        "deskripsi": { "type": "string", "maxLength": 1000 },
        "tingkat": { "type": "string", "enum": ["Bantara", "Laksana"] }
      },
      "required": ["id", "no_item", "deskripsi", "tingkat"]
    },
    "Tabungan": {
      "title": "Tabungan",
      "description": "Transaksi tabungan wajib dan sukarela anggota",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "siswa_id": { "type": "string", "maxLength": 128 },
        "tanggal": { "type": "string", "maxLength": 50 },
        "jumlah": { "type": "number" },
        "jenis": { "type": "string", "enum": ["Wajib", "Sukarela"] },
        "keterangan": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "siswa_id", "tanggal", "jumlah", "jenis"]
    },
    "Kedisiplinan": {
      "title": "Kedisiplinan",
      "description": "Catatan pelanggaran dan prestasi / apresiasi poin kedisiplinan",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "siswa_id": { "type": "string", "maxLength": 128 },
        "tanggal": { "type": "string", "maxLength": 50 },
        "tipe": { "type": "string", "enum": ["Prestasi", "Pelanggaran"] },
        "keterangan": { "type": "string", "maxLength": 500 },
        "poin": { "type": "number" }
      },
      "required": ["id", "siswa_id", "tanggal", "tipe", "keterangan", "poin"]
    },
    "Jurnal": {
      "title": "Jurnal",
      "description": "Catatan jurnal harian dan evaluasi kegiatan pembina",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "tanggal": { "type": "string", "maxLength": 50 },
        "judul_kegiatan": { "type": "string", "maxLength": 200 },
        "materi_id": { "type": "string", "maxLength": 128 },
        "pembina_nama": { "type": "string", "maxLength": 200 },
        "evaluasi_ringkas": { "type": "string", "maxLength": 2000 }
      },
      "required": ["id", "tanggal", "judul_kegiatan", "pembina_nama", "evaluasi_ringkas"]
    },
    "Kelas": {
      "title": "Kelas",
      "description": "Daftar master kelas SMK Bakti Idhata",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "nama": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "nama"]
    },
    "AppSetting": {
      "title": "AppSetting",
      "description": "Pengaturan master sistem seperti Tahun Ajaran dan Status Pelantikan",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "values": { "type": "array" }
      },
      "required": ["id"]
    },
    "PengawasAccount": {
      "title": "PengawasAccount",
      "description": "Daftar email Google pribadi pengawas yang diberikan akses oleh Pembina/Admin",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "nama": { "type": "string", "maxLength": 200 },
        "email": { "type": "string", "maxLength": 200 },
        "jabatan": { "type": "string", "maxLength": 200 },
        "tanggalDitambahkan": { "type": "string", "maxLength": 50 },
        "ditambahkanOleh": { "type": "string", "maxLength": 200 },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "nama", "email", "jabatan"]
    }
  },
  "firestore": {
    "/siswa/{siswaId}": {
      "schema": "Siswa",
      "description": "Koleksi data anggota murid Pramuka"
    },
    "/kehadiran/{kehadiranId}": {
      "schema": "Kehadiran",
      "description": "Koleksi absensi kehadiran"
    },
    "/materi/{materiId}": {
      "schema": "Materi",
      "description": "Koleksi modul materi mingguan"
    },
    "/sku/{skuId}": {
      "schema": "SKU",
      "description": "Koleksi kelulusan poin SKU siswa"
    },
    "/skuDefs/{defId}": {
      "schema": "SKUItemDef",
      "description": "Koleksi definisi standar butir SKU"
    },
    "/tabungan/{tabunganId}": {
      "schema": "Tabungan",
      "description": "Koleksi transaksi tabungan siswa"
    },
    "/kedisiplinan/{kedisiplinanId}": {
      "schema": "Kedisiplinan",
      "description": "Koleksi riwayat poin kedisiplinan dan prestasi siswa"
    },
    "/jurnal/{jurnalId}": {
      "schema": "Jurnal",
      "description": "Koleksi jurnal latihan kegiatan pembina"
    },
    "/kelas/{kelasId}": {
      "schema": "Kelas",
      "description": "Koleksi master daftar kelas"
    },
    "/settings/{settingId}": {
      "schema": "AppSetting",
      "description": "Koleksi pengaturan master aplikasi"
    },
    "/pengawasAccounts/{accountId}": {
      "schema": "PengawasAccount",
      "description": "Koleksi akun pengawas yang didaftarkan melalui email Google pribadi"
    }
  }
}
