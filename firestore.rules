rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to validate ID
    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Default catch-all rule
    match /{document=**} {
      allow read, write: if true;
    }

    // Specific match rules for collections
    match /siswa/{siswaId} {
      allow read, write: if isValidId(siswaId);
    }

    match /kehadiran/{kehadiranId} {
      allow read, write: if isValidId(kehadiranId);
    }

    match /materi/{materiId} {
      allow read, write: if isValidId(materiId);
    }

    match /sku/{skuId} {
      allow read, write: if isValidId(skuId);
    }

    match /skuDefs/{defId} {
      allow read, write: if isValidId(defId);
    }

    match /tabungan/{tabunganId} {
      allow read, write: if isValidId(tabunganId);
    }

    match /kedisiplinan/{kedisiplinanId} {
      allow read, write: if isValidId(kedisiplinanId);
    }

    match /jurnal/{jurnalId} {
      allow read, write: if isValidId(jurnalId);
    }

    match /kelas/{kelasId} {
      allow read, write: if isValidId(kelasId);
    }

    match /skk/{skkId} {
      allow read, write: if isValidId(skkId);
    }

    match /skkDefs/{defId} {
      allow read, write: if isValidId(defId);
    }

    match /kegiatanEvents/{eventId} {
      allow read, write: if isValidId(eventId);
    }

    match /inventaris/{itemId} {
      allow read, write: if isValidId(itemId);
    }

    match /peminjaman/{loanId} {
      allow read, write: if isValidId(loanId);
    }

    match /modulMateri/{modulId} {
      allow read, write: if isValidId(modulId);
    }

    match /silabus/{silabusId} {
      allow read, write: if isValidId(silabusId);
    }

    match /kas/{kasId} {
      allow read, write: if isValidId(kasId);
    }

    match /dewanAmbalan/{daId} {
      allow read, write: if isValidId(daId);
    }

    match /settings/{settingId} {
      allow read, write: if isValidId(settingId);
    }

    match /pengawasAccounts/{accountId} {
      allow read, write: if isValidId(accountId);
    }
  }
}
